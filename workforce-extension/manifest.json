{
  "manifest_version": 3,
  "name": "ShiftSync Quick Access",
  "version": "1.0.0",
  "description": "Desktop shortcuts to the ShiftSync workforce portal. Sign-in, MFA and role checks stay in the web app.",
  "homepage_url": "https://wfm.advancedvirtualsolutions.com/",
  "minimum_chrome_version": "102",
  "incognito": "not_allowed",
  "permissions": [],
  "host_permissions": [],
  "action": {
    "default_title": "ShiftSync Quick Access",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
