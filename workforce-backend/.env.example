PORT=5000
MONGO_URI=
JWT_SECRET=
MFA_ENCRYPTION_SECRET=
MFA_REQUIRED=true
MFA_ISSUER=ShiftSync
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# One-time admin bootstrap. Do not commit real credentials.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_TIMEZONE=Europe/London

# UK project time: zone in which template wall-clock times ("09:00") and
# shift windows are interpreted. The docker containers are pinned to this
# zone as well (TZ).
BUSINESS_TIME_ZONE=Europe/London

# Gemini AI (powers the AI Analysis & Summary feature). Falls back to an
# offline deterministic summary when the key is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Minimum gap between any two Gemini calls, shared by shift analysis and
# screenshot narration. Raise it if you hit 429s on the free tier.
GEMINI_CALL_SPACING_MS=6500

# --- Screenshot narration (vision) -----------------------------------------
# Turns captured screenshots into a per-block account of what the worker was
# doing. One Gemini vision call per block of frames; results are cached per
# shift, so regenerating an analysis does not pay twice.
VISION_ENABLED=true
# Vision-capable model. gemini-2.5-flash-lite has a larger free daily quota.
GEMINI_VISION_MODEL=gemini-2.5-flash
# Unique frames per narrated block (one model call each).
VISION_BLOCK_FRAMES=6
# Hard cap on model calls per shift; extra frames are sampled evenly.
VISION_MAX_BLOCKS=8
VISION_MAX_CAPTURES=96
# Width of one tile in the contact sheet sent to the model.
VISION_TILE_WIDTH=640
# 0-64 Hamming distance at which two frames count as the same screen.
VISION_DEDUPE_DISTANCE=5
# always = OCR every block before vision (slower, better app names)
# fallback = OCR only when vision fails (default)
# off = never OCR
VISION_OCR_MODE=fallback
VISION_OCR_MAX_CHARS=2400
# How long an inline analysis request may spend building narration before it
# continues without it (the background queue has no limit).
VISION_INLINE_BUDGET_MS=60000
VISION_REQUEST_TIMEOUT_MS=45000
