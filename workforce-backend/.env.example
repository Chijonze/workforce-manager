PORT=5000
MONGO_URI=
JWT_SECRET=
MFA_ENCRYPTION_SECRET=
MFA_REQUIRED=true
MFA_ISSUER=ShiftSync
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# One-time admin bootstrap. Do not commit real credentials.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_TIMEZONE=Europe/London

# UK project time: zone in which template wall-clock times ("09:00") and
# shift windows are interpreted. The docker containers are pinned to this
# zone as well (TZ).
BUSINESS_TIME_ZONE=Europe/London

# --- AI analysis engine ------------------------------------------------------
# Powers the AI Analysis & Summary feature (shift reports and long-form period
# reports). Falls back to a complete deterministic report when the key is empty,
# so the product keeps working before the key is installed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Lightweight multimodal model. It reads the screenshot contact sheets directly
# (vision) and writes the long-form reports, so one model covers both jobs.
AI_ANALYSIS_MODEL=deepseek-flash
AI_VISION_MODEL=deepseek-flash

# Output budgets. Long reports are truncated if these are too small.
AI_ANALYSIS_MAX_TOKENS=7000
AI_AGGREGATE_MAX_TOKENS=9000
AI_NARRATION_MAX_TOKENS=1400

# off = fastest, auto = deeper reasoning for period reports only, on = always.
AI_THINKING=off
AI_REASONING_EFFORT=high

# Optional pacing between provider calls. 0 is correct for the hosted API; raise
# it only if a deployment starts seeing 429s.
AI_CALL_SPACING_MS=0
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_MS=2000
AI_ANALYSIS_TIMEOUT_MS=180000
AI_AGGREGATE_TIMEOUT_MS=300000
AI_VISION_TIMEOUT_MS=150000

# --- Screenshot narration ----------------------------------------------------
# Turns captured screenshots into a per-window account of what the worker was
# doing. Each block is one multimodal call over a contact sheet plus locally
# extracted OCR text; results are cached per shift, so regenerating an analysis
# does not pay twice.
VISION_ENABLED=true
# Unique frames per narrated block (one model call each).
VISION_BLOCK_FRAMES=6
# Hard cap on model calls per shift; extra frames are sampled evenly.
VISION_MAX_BLOCKS=8
VISION_MAX_CAPTURES=96
# Width of one tile in the contact sheet sent to the model.
VISION_TILE_WIDTH=720
# 0-64 Hamming distance at which two frames count as the same screen.
VISION_DEDUPE_DISTANCE=5
# always = OCR every block and send the transcript with the images (best names)
# fallback = OCR only when the multimodal call fails
# off = never OCR
VISION_OCR_MODE=always
VISION_OCR_MAX_CHARS=4000
# How long an inline analysis request may spend building narration before it
# continues without it (the background queue has no limit).
VISION_INLINE_BUDGET_MS=90000

# Background retry of shifts whose narration failed or was cut short. The sweep
# pauses automatically while the provider is throttling and resumes once the
# retry window has passed.
VISION_RETRY_ENABLED=true
VISION_RETRY_INTERVAL_MS=900000
VISION_RETRY_MAX_SHIFTS_PER_DAY=2
VISION_RETRY_LOOKBACK_DAYS=7
