DOMAIN=advancedvirtualsolutions.com
WFM_DOMAIN=wfm.advancedvirtualsolutions.com
API_DOMAIN=api.advancedvirtualsolutions.com
CHATWOOT_DOMAIN=chat.advancedvirtualsolutions.com
LIVEKIT_DOMAIN=livekit.advancedvirtualsolutions.com
ACME_EMAIL=admin@advancedvirtualsolutions.com

NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/advancedvirtualsolutions/consultation
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/447882615046

MONGO_ROOT_USERNAME=workforce
MONGO_ROOT_PASSWORD=change-this-mongo-password
MONGO_DATABASE=workforce
JWT_SECRET=change-this-long-random-jwt-secret
MFA_ENCRYPTION_SECRET=change-this-32-byte-base64-or-long-secret
MFA_REQUIRED=true
MFA_ISSUER=ShiftSync
SCREEN_MONITOR_ADMIN_KEY=change-this-screen-monitor-admin-key
# Directory (inside the backend container) where shift monitoring screenshots are stored
MONITORING_UPLOADS_DIR=/app/uploads/monitoring
CORS_ORIGINS=https://wfm.advancedvirtualsolutions.com,https://advancedvirtualsolutions.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_TIMEZONE=Europe/London
# UK project time: schedule template wall-clock times and shift windows are
# interpreted in this zone by both the backend and the workforce frontend.
BUSINESS_TIME_ZONE=Europe/London

# AVS website assistant only (the marketing-site chatbot keeps its own provider).
# The WFM AI Analysis & Summary feature does NOT use this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# WFM AI Analysis & Summary engine. Powers shift reports, screenshot narration
# and the long-form period reports. Falls back to the deterministic report when
# the key is empty.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_ANALYSIS_MODEL=deepseek-flash
AI_VISION_MODEL=deepseek-flash
AI_THINKING=off
AI_ANALYSIS_MAX_TOKENS=7000
AI_AGGREGATE_MAX_TOKENS=9000

POSTGRES_DB=chatwoot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password

CHATWOOT_IMAGE_TAG=latest-ce
CHATWOOT_SECRET_KEY_BASE=change-this-rails-secret-key-base
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_INBOX_ID=
CHATWOOT_BOT_ACCESS_TOKEN=

LIVEKIT_IMAGE_TAG=v1.9
LIVEKIT_API_KEY=change-this-livekit-api-key
LIVEKIT_API_SECRET=change-this-livekit-api-secret
LIVEKIT_BIND_ADDRESS=127.0.0.1
LIVEKIT_CONTROL_PORT=7801
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_TOKEN_API_KEY=change-this-long-random-token-api-key
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
